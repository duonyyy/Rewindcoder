{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rewindcoder.dev/schemas/task/v1",
  "title": "RewindCoder Task v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "repository", "issue", "explicit_requirements", "target_commands", "regression_commands", "forbidden_paths", "budget"],
  "properties": {
    "schema_version": {"const": "task/v1"},
    "task_id": {"type": "string", "minLength": 1},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "base_commit"],
      "properties": {
        "kind": {"enum": ["fixture", "local"]},
        "path": {"type": "string", "minLength": 1},
        "base_commit": {"type": "string", "minLength": 1}
      }
    },
    "issue": {"type": "string", "minLength": 1},
    "explicit_requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "target_commands": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "regression_commands": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "forbidden_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_agent_steps", "max_rewinds", "max_tokens", "max_tool_calls", "timeout_seconds"],
      "properties": {
        "max_agent_steps": {"type": "integer", "minimum": 0},
        "max_rewinds": {"type": "integer", "minimum": 0},
        "max_tokens": {"type": "integer", "minimum": 0},
        "max_tool_calls": {"type": "integer", "minimum": 0},
        "timeout_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "evaluator_only": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hidden_requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "gold_patch": {"type": "string", "minLength": 1},
        "expected_outcome": {"type": "object"}
      }
    }
  }
}
